# ============================================================
# SOUVERAIN-OS — Variables d'environnement (exemple)
# ============================================================
# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne JAMAIS commiter le fichier .env réel.
#
# Brique 0 : aucune variable métier n'est encore nécessaire.
# Les sections ci-dessous sont préparées pour les briques futures
# et sont commentées tant qu'elles ne sont pas implémentées.
# ============================================================

# --- Brique 0 : Fondations ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Brique 1 : PostgreSQL / TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=souverain_os
POSTGRES_USER=souverain_admin
POSTGRES_PASSWORD=change_me

# --- Brique 2 : Auth / RBAC ---
JWT_SECRET_KEY=change_me_dev_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# --- Brique 6 : Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Phase transverse : Ollama (non actif) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral:7b-instruct-q4_K_M
