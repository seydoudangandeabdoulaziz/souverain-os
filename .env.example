# ============================================================
# SOUVERAIN-OS — Variables d'environnement (exemple)
# ============================================================
# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne JAMAIS commiter le fichier .env réel.
#
# Brique 0 : aucune variable métier n'est encore nécessaire.
# Les sections ci-dessous sont préparées pour les briques futures
# et sont commentées tant qu'elles ne sont pas implémentées.
# ============================================================

# --- Brique 0 : Fondations ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Brique 1 : PostgreSQL / TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=souverain_os
POSTGRES_USER=souverain_admin
POSTGRES_PASSWORD=change_me

# --- Brique 2 : Auth / RBAC ---
JWT_SECRET_KEY=change_me_dev_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# --- Brique 6 : Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Brique 8 : Audit trail + Human-in-the-loop ---
# Rôle PostgreSQL DÉDIÉ (distinct de POSTGRES_USER/souverain_admin) :
# privilèges volontairement limités à INSERT/SELECT sur {tenant}.audit_log
# (+ SELECT/UPDATE sur {tenant}.alertes, requis pour fermer une alerte
# dans la même transaction) — voir migrations/0001 de la Brique 8.
# Créé par cette migration avec ce mot de passe par défaut ; DOIT être
# changé (ALTER ROLE côté base + cette variable) avant tout déploiement
# réel, même règle que NEO4J_PASSWORD ci-dessus.
AUDIT_DB_USER=souverain_brique8_audit
AUDIT_DB_PASSWORD=change_me_audit

# --- Brique 1 V2 : Gouvernance des tenants (CLI-only) ---
# Rôle PostgreSQL DÉDIÉ pour le CLI de création/activation/désactivation
# de tenants — privilège CREATE nécessaire au provisioning de schéma,
# mais jamais UPDATE/DELETE sur shared.gouvernance_audit_log. Voir
# migrations/0002 de la Brique 1.
GOUVERNANCE_CLI_DB_USER=souverain_gouvernance_cli
GOUVERNANCE_CLI_DB_PASSWORD=change_me_gouvernance_cli

# --- Brique 2 V2 : Gouvernance des utilisateurs (routes web admin) ---
# Rôle PostgreSQL DÉDIÉ pour les routes de gestion des comptes
# utilisateurs — DML uniquement sur shared.users, jamais de privilège
# DDL. Voir migrations/0002 de la Brique 2.
GOUVERNANCE_WEB_DB_USER=souverain_gouvernance_web
GOUVERNANCE_WEB_DB_PASSWORD=change_me_gouvernance_web

# --- Phase transverse : Ollama (non actif) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral:7b-instruct-q4_K_M

# --- Étape 4a : Observabilité (Prometheus/Grafana) ---
# Prometheus et Grafana ne publient aucun port sur l'hôte par défaut
# (accès via docker-compose.override.yml en local, voir l'exemple).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# --- Étape 4b : métriques PostgreSQL (postgres-exporter) ---
MONITORING_DB_USER=souverain_monitoring
MONITORING_DB_PASSWORD=change_me_monitoring
